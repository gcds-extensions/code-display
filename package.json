{
  "name": "@gcds-extensions/code-display",
  "version": "0.0.1",
  "description": "Stencil Component Starter",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/gcds-ext-code-display/gcds-ext-code-display.esm.js",
  "exports": {
    ".": {
      "import": "./dist/gcds-ext-code-display/gcds-ext-code-display.esm.js",
      "require": "./dist/gcds-ext-code-display/gcds-ext-code-display.cjs.js"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gcds-extensions/code-display.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "stencil test --spec",
    "test:e2e": "npx playwright test",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@bgotink/playwright-coverage": "^0.3.2",
    "@gcds-core/components": "^1.3.1",
    "@playwright/test": "^1.61.1",
    "@stencil/core": "^4.27.1",
    "@stencil/playwright": "^0.5.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "@types/prismjs": "^1.26.5",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.3.0",
    "rollup-plugin-node-polyfills": "^0.2.1"
  },
  "license": "MIT",
  "dependencies": {
    "axe-core": "^4.10.3",
    "dompurify": "^3.4.12",
    "prettier": "^3.6.2",
    "prismjs": "^1.30.0"
  },
  "peerDependencies": {
    "@gcds-core/components": "^1.3.1"
  }
}
